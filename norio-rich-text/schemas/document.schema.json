                  "descriptionVisible": {
                    "type": "boolean"
                  },
                  "link": {
                    "type": "string"
                  },
                  "linkTarget": {
                    "enum": [
                      "_blank",
                      "_self"
                    ]
                  },
                  "rotation": {
                    "type": "number"
                  }
                }
              }
            },
            "widthPercent": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "height": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
