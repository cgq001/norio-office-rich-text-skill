        "type": {
          "const": "linkBlock"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "displayMode": {
              "enum": [
                "text",
                "card",
                "preview"
              ]
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "widthPercent": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "height": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "marks": {
          "type": "array",
