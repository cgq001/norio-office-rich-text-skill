        "type": {
          "const": "tableCell"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "colspan": {
              "type": "integer",
              "minimum": 1
            },
            "rowspan": {
              "type": "integer",
              "minimum": 1
            },
            "colwidth": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right",
                null
              ]
            },
            "backgroundColor": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80,
              "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\([\\d.%\\s,/]+\\)|[a-zA-Z]+)$"
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_horizontalRule": {
      "type": "object",
      "properties": {
        "type": {
          "const": "horizontalRule"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "lineStyle": {
              "enum": [
                "solid",
                "dashed",
                "dotted"
              ]
            },
            "lineColor": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80,
              "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\([\\d.%\\s,/]+\\)|[a-zA-Z]+)$"
            }
          },
          "additionalProperties": false
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_columnsBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "columnsBlock"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "widths": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
