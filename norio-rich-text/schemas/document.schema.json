        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_countdownBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "countdownBlock"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "targetTimestamp": {
              "type": "integer",
              "minimum": 0
            },
            "mode": {
              "type": "string"
            },
            "color": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\([\\d.%\\s,/]+\\)|[a-zA-Z]+)$"
            },
            "reminderEnabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_formulaBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "formulaBlock"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
