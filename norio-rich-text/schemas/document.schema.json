{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norio-office.github.io/rich-text/document.schema.json",
  "title": "Norio rich text document",
  "$ref": "#/$defs/node_doc",
  "$defs": {
    "mark_link": {
      "type": "object",
      "properties": {
        "type": {
          "const": "link"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "href": {
              "type": [
                "string",
                "null"
              ]
            },
            "target": {
              "type": "string"
            },
            "rel": {
              "type": "string"
            },
            "class": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "mark_textStyle": {
      "type": "object",
      "properties": {
        "type": {
          "const": "textStyle"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "fontFamily": {
              "type": [
                "string",
                "null"
              ]
            },
            "fontSize": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d{1,3}px$"
            },
            "backgroundColor": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80,
              "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\([\\d.%\\s,/]+\\)|[a-zA-Z]+)$"
            },
            "color": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80,
              "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\([\\d.%\\s,/]+\\)|[a-zA-Z]+)$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "mark_bold": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bold"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "mark_code": {
      "type": "object",
      "properties": {
        "type": {
          "const": "code"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "mark_italic": {
      "type": "object",
      "properties": {
        "type": {
          "const": "italic"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "mark_strike": {
      "type": "object",
      "properties": {
        "type": {
          "const": "strike"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "mark_commentMark": {
      "type": "object",
      "properties": {
        "type": {
          "const": "commentMark"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "threadId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "mark_superscript": {
      "type": "object",
      "properties": {
        "type": {
          "const": "superscript"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "mark_subscript": {
      "type": "object",
      "properties": {
        "type": {
          "const": "subscript"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "mark_underline": {
      "type": "object",
      "properties": {
        "type": {
          "const": "underline"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_paragraph": {
      "type": "object",
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "indent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "textAlign": {
              "enum": [
                "left",
                "center",
                "right",
                null
              ]
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_blockquote": {
      "type": "object",
      "properties": {
        "type": {
          "const": "blockquote"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "quoteBorderColor": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\([\\d.%\\s,/]+\\)|[a-zA-Z]+)$"
            },
            "quoteBackgroundColor": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\([\\d.%\\s,/]+\\)|[a-zA-Z]+)$"
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_bulletList": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bulletList"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_doc": {
      "type": "object",
      "properties": {
        "type": {
          "const": "doc"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_hardBreak": {
      "type": "object",
      "properties": {
        "type": {
          "const": "hardBreak"
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_heading": {
      "type": "object",
      "properties": {
        "type": {
          "const": "heading"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "indent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "textAlign": {
              "enum": [
                "left",
                "center",
                "right",
                null
              ]
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_listItem": {
      "type": "object",
      "properties": {
        "type": {
          "const": "listItem"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_orderedList": {
      "type": "object",
      "properties": {
        "type": {
          "const": "orderedList"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "enum": [
                "1",
                "a",
                "A",
                "i",
                "I",
                null
              ]
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_text": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "node_table": {
      "type": "object",
      "properties": {
        "type": {
          "const": "table"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "tableTheme": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "header",
                    "odd",
                    "even"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "header": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "odd": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "even": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_tableRow": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tableRow"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_tableHeader": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tableHeader"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "colspan": {
              "type": "integer",
              "minimum": 1
            },
            "rowspan": {
              "type": "integer",
              "minimum": 1
            },
            "colwidth": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right",
                null
              ]
            },
            "backgroundColor": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80,
              "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\([\\d.%\\s,/]+\\)|[a-zA-Z]+)$"
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_tableCell": {
      "type": "object",
