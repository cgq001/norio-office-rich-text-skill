            "latex": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "node_imageBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "imageBlock"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "aiId": {
              "type": [
                "string",
                "null"
              ]
            },
            "images": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "assetId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "src": {
                    "type": "string"
                  },
                  "alt": {
                    "type": "string"
